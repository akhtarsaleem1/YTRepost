# ══════════════════════════════════════════════════════════════
#  YouTube Auto-Reposter — Environment Variables
#  Deploy on Railway: add these in Railway → Variables tab
# ══════════════════════════════════════════════════════════════

# ── Google / YouTube API ───────────────────────────────────────
YOUTUBE_API_KEY=AIzaSyBdRJHIlCcCn0LdB-UxHH3L-0VKwjVIg4c
YOUTUBE_CLIENT_ID=673629947182-tk52p16svivqt3k1525kmmdhb2co13cl.apps.googleusercontent.com

# ⚠️  STILL NEEDED: Get this from Google Cloud Console
#     Go to: APIs & Services → Credentials → your OAuth client → copy "Client Secret"
YOUTUBE_CLIENT_SECRET=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

# ── Channels ────────────────────────────────────────────────────
# Source channel: @kingslayeroffical (you upload manually here)
SOURCE_CHANNEL_ID=UCZkLRWVabarmwiTvAneP_eQ

# Target channel: videos auto-upload here after processing
TARGET_CHANNEL_ID=UC2HKQFf-HDw8UGGlIyW95kA

# ⚠️  STILL NEEDED: Visit https://your-app.railway.app/setup to authorize
#     and get this token for your target channel
TARGET_REFRESH_TOKEN=PASTE_REFRESH_TOKEN_AFTER_SETUP

# ── App Settings ─────────────────────────────────────────────────
PORT=3000
APP_URL=https://your-app.railway.app

# Auto-generate a random secret for the setup page
SETUP_SECRET=kingslayer_setup_2024

# ── Processing Config ────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=5
CLIP_SEGMENTS=8
REVERSE_CLIP_CHANCE=0.4
SPEED_MIN=0.97
SPEED_MAX=1.03
AUDIO_PITCH_SHIFT=1
ENABLE_HORIZONTAL_FLIP=false
ENABLE_COLOR_CORRECTION=true
OUTPUT_FORMAT=mp4

# Upload privacy: public / unlisted / private
UPLOAD_PRIVACY=public

# ── Storage ───────────────────────────────────────────────────────
PROCESSING_TEMP_DIR=/tmp/yt-reposter
DB_PATH=./data/state.json
