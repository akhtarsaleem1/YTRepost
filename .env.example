# Copy to .env for local use. Fill these values yourself; never commit .env.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
SOURCE_CHANNEL_ID=
TARGET_CHANNEL_ID=
# Generate a unique password of at least 32 characters. Username is admin.
ADMIN_PASSWORD=
# Leave empty until authenticated OAuth setup is complete.
TARGET_REFRESH_TOKEN=

PORT=3000
# Use your HTTPS deployment origin in production; no path or trailing slash.
APP_URL=http://localhost:3000
CHECK_INTERVAL_MINUTES=5
UPLOAD_PRIVACY=private

CLIP_SEGMENTS=8
REVERSE_CLIP_CHANCE=0.4
SPEED_MIN=0.97
SPEED_MAX=1.03
AUDIO_PITCH_SHIFT=1
ENABLE_HORIZONTAL_FLIP=false
ENABLE_COLOR_CORRECTION=true
OUTPUT_FORMAT=mp4
# Optional: paths to private storage, excluded from version control.
PROCESSING_TEMP_DIR=
DB_PATH=
